<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Runs sequentially: there is one emulator, and two Appium sessions on the same device would
  fight over the same app. Run with: ./mvnw test -Dsuite=src/test/resources/testng-mobile.xml
-->
<suite name="My Demo App Android" parallel="none">
    <test name="Mobile">
        <groups>
            <run>
                <exclude name="known-defect"/>
            </run>
        </groups>
        <classes>
            <class name="mobile.MobileLoginTest"/>
            <class name="mobile.MobileCartTest"/>
            <class name="mobile.MobileCheckoutTest"/>
        </classes>
    </test>
</suite>

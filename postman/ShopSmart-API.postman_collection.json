{
  "info": {
    "name": "ShopSmart API",
    "description": "CRUD and negative tests for the public Restful Booker practice API.\nDocs: https://restful-booker.herokuapp.com/apidoc/index.html\n\nRun order matters: folders share state through collection variables (token, bookingId, ...).\nCredentials are NOT stored here. Provide them at run time:\n  newman run ... --env-var username=$RB_USERNAME --env-var password=$RB_PASSWORD\n\nTests tagged [KNOWN DEFECT BUG-API-xx] assert the API's CURRENT (incorrect) behaviour\nso the suite stays green; each defect is documented in docs/bug-reports.md.\nIf the API is fixed, those tests fail and tell you to update them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fail fast with a clear message if credentials were not supplied.",
          "const missing = ['baseUrl', 'username', 'password'].filter(k => !pm.variables.get(k));",
          "if (missing.length) {",
          "    throw new Error('Missing variables: ' + missing.join(', ') +",
          "        '. Pass them with --env-var (Newman) or set them in your local Postman environment.');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs after EVERY request in the collection.",
          "pm.test('Response time is under 5000 ms', () => {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "negBookingId",
      "value": ""
    },
    {
      "key": "invalidPriceId",
      "value": ""
    },
    {
      "key": "reversedDatesId",
      "value": ""
    },
    {
      "key": "firstname",
      "value": ""
    },
    {
      "key": "lastname",
      "value": "ShopSmartQA"
    },
    {
      "key": "checkin",
      "value": ""
    },
    {
      "key": "checkout",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Health",
      "item": [
        {
          "name": "Ping",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 (documented health-check response)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ping"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Create token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response contains a non-empty token', () => {",
                  "    pm.expect(body.token, JSON.stringify(body)).to.be.a('string').and.not.be.empty;",
                  "});",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "[NEG] Wrong password is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// [KNOWN DEFECT BUG-API-01] API returns 200 instead of 401 for bad credentials.",
                  "pm.test('[KNOWN DEFECT BUG-API-01] Status is 200 (should be 401)', () => pm.response.to.have.status(200));",
                  "pm.test('Reason is \"Bad credentials\" and no token is issued', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.reason).to.eql('Bad credentials');",
                  "    pm.expect(body).to.not.have.property('token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"definitely-wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "[NEG] Empty credentials are rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[KNOWN DEFECT BUG-API-01] Status is 200 (should be 400/401)', () => pm.response.to.have.status(200));",
                  "pm.test('No token is issued', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.reason).to.eql('Bad credentials');",
                  "    pm.expect(body).to.not.have.property('token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "02 Bookings - CRUD",
      "item": [
        {
          "name": "Create booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique test data per run so parallel/repeated runs never collide on the shared server.",
                  "const day = 24 * 60 * 60 * 1000;",
                  "const iso = d => new Date(d).toISOString().slice(0, 10);",
                  "pm.collectionVariables.set('firstname', 'QA' + Date.now());",
                  "pm.collectionVariables.set('checkin', iso(Date.now() + 30 * day));",
                  "pm.collectionVariables.set('checkout', iso(Date.now() + 33 * day));",
                  "pm.variables.set('totalprice', 150);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "const bookingSchema = {",
                  "    type: 'object',",
                  "    required: ['firstname', 'lastname', 'totalprice', 'depositpaid', 'bookingdates'],",
                  "    properties: {",
                  "        firstname: { type: 'string' },",
                  "        lastname: { type: 'string' },",
                  "        totalprice: { type: 'number' },",
                  "        depositpaid: { type: 'boolean' },",
                  "        bookingdates: {",
                  "            type: 'object',",
                  "            required: ['checkin', 'checkout'],",
                  "            properties: {",
                  "                checkin: { type: 'string', pattern: '^\\\\d{4}-\\\\d{2}-\\\\d{2}$' },",
                  "                checkout: { type: 'string', pattern: '^\\\\d{4}-\\\\d{2}-\\\\d{2}$' }",
                  "            }",
                  "        },",
                  "        additionalneeds: { type: 'string' }",
                  "    }",
                  "};",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('bookingid is a positive integer', () => {",
                  "    pm.expect(body.bookingid).to.be.a('number').and.above(0);",
                  "});",
                  "pm.test('Returned booking matches the schema', () => {",
                  "    pm.expect(body.booking).to.have.jsonSchema(bookingSchema);",
                  "});",
                  "pm.test('Returned booking echoes the request', () => {",
                  "    const sent = JSON.parse(pm.request.body.raw.replace('{{totalprice}}', '150')",
                  "        .replace(/{{(\\w+)}}/g, (_, k) => pm.collectionVariables.get(k)));",
                  "    pm.expect(body.booking).to.eql(sent);",
                  "});",
                  "pm.collectionVariables.set('bookingId', body.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"{{lastname}}\",\n  \"totalprice\": {{totalprice}},\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"{{checkin}}\",\n    \"checkout\": \"{{checkout}}\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get booking by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "const bookingSchema = {",
                  "    type: 'object',",
                  "    required: ['firstname', 'lastname', 'totalprice', 'depositpaid', 'bookingdates'],",
                  "    properties: {",
                  "        firstname: { type: 'string' },",
                  "        lastname: { type: 'string' },",
                  "        totalprice: { type: 'number' },",
                  "        depositpaid: { type: 'boolean' },",
                  "        bookingdates: {",
                  "            type: 'object',",
                  "            required: ['checkin', 'checkout'],",
                  "            properties: {",
                  "                checkin: { type: 'string', pattern: '^\\\\d{4}-\\\\d{2}-\\\\d{2}$' },",
                  "                checkout: { type: 'string', pattern: '^\\\\d{4}-\\\\d{2}-\\\\d{2}$' }",
                  "            }",
                  "        },",
                  "        additionalneeds: { type: 'string' }",
                  "    }",
                  "};",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Matches the schema', () => pm.expect(body).to.have.jsonSchema(bookingSchema));",
                  "pm.test('Data matches what was created', () => {",
                  "    pm.expect(body.firstname).to.eql(pm.collectionVariables.get('firstname'));",
                  "    pm.expect(body.lastname).to.eql(pm.collectionVariables.get('lastname'));",
                  "    pm.expect(body.totalprice).to.eql(150);",
                  "    pm.expect(body.bookingdates.checkin).to.eql(pm.collectionVariables.get('checkin'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          }
        },
        {
          "name": "Search booking ids by name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Result contains the new booking', () => {",
                  "    const ids = pm.response.json().map(b => b.bookingid);",
                  "    pm.expect(ids).to.include(Number(pm.collectionVariables.get('bookingId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking?firstname={{firstname}}&lastname={{lastname}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ],
              "query": [
                {
                  "key": "firstname",
                  "value": "{{firstname}}"
                },
                {
                  "key": "lastname",
                  "value": "{{lastname}}"
                }
              ]
